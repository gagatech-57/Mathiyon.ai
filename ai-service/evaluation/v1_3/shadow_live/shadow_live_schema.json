{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MathiyonShadowLiveRecord",
  "description": "Sanitized Shadow Evaluation Log Record Schema for Mathiyon SLM v1.3-RC1 (Phase 11.13)",
  "type": "object",
  "required": [
    "shadow_id",
    "timestamp",
    "category",
    "production_model",
    "shadow_model",
    "shadow_model_status",
    "request_sanitized",
    "privacy_redactions",
    "v1_2_latency_ms",
    "v1_3_latency_ms",
    "v1_2_status",
    "v1_3_status",
    "v1_2_tokens",
    "v1_3_tokens",
    "tool_route",
    "math_engine_used",
    "rag_used",
    "comparison_status"
  ],
  "properties": {
    "shadow_id": {
      "type": "string",
      "pattern": "^shadow_[a-zA-Z0-9_-]+$",
      "description": "Non-sensitive synthetic shadow evaluation identifier"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp of evaluation"
    },
    "category": {
      "type": "string",
      "enum": ["GENERAL", "CODE", "MATH", "DOCUMENT", "WEB", "OTHER"],
      "description": "Request intent category"
    },
    "production_model": {
      "type": "string",
      "enum": ["mathiyon-slm-v1.2"],
      "description": "Name of production serving model (100% traffic default)"
    },
    "shadow_model": {
      "type": "string",
      "enum": ["mathiyon-slm-v1.3", "mathiyon-slm-v1.3-RC1"],
      "description": "Name of experimental shadow model"
    },
    "shadow_model_status": {
      "type": "string",
      "enum": ["experimental"],
      "description": "Governance status of shadow model"
    },
    "request_sanitized": {
      "type": "boolean",
      "enum": [true],
      "description": "Confirmation that request underwent privacy scrubbing"
    },
    "privacy_redactions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of redacted secret or PII categories"
    },
    "v1_2_latency_ms": {
      "type": "number",
      "minimum": 0,
      "description": "Production v1.2 response latency in milliseconds"
    },
    "v1_3_latency_ms": {
      "type": "number",
      "minimum": 0,
      "description": "Shadow v1.3 evaluation latency in milliseconds"
    },
    "v1_2_status": {
      "type": "string",
      "enum": ["success", "error"],
      "description": "Execution status of production model"
    },
    "v1_3_status": {
      "type": "string",
      "enum": ["success", "error", "timeout"],
      "description": "Execution status of shadow model"
    },
    "v1_2_tokens": {
      "type": "integer",
      "minimum": 0,
      "description": "Token count generated by v1.2"
    },
    "v1_3_tokens": {
      "type": "integer",
      "minimum": 0,
      "description": "Token count generated by v1.3"
    },
    "tool_route": {
      "type": "string",
      "enum": ["GENERAL", "MATH", "RAG", "CODE", "WEB", "OTHER"],
      "description": "Routing target for request"
    },
    "math_engine_used": {
      "type": "boolean",
      "description": "Flag indicating whether SymPy Math Engine was executed"
    },
    "rag_used": {
      "type": "boolean",
      "description": "Flag indicating whether vector RAG retrieval was executed"
    },
    "comparison_status": {
      "type": "string",
      "description": "Governance category classification (A through K)"
    }
  },
  "additionalProperties": false
}
