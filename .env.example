# Frontend Environment Variables (Vite)
# Copy this file to .env.local for development

# API Base URL (optional; defaults to /api so the app works behind a reverse proxy)
# VITE_API_BASE_URL=https://api.example.com

# Express backend
# PORT=5000
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/mathiyon
# JWT_SECRET=replace-with-strong-secret
# CORS_ORIGINS=http://localhost:8645,http://localhost:5173,https://your-domain.com
# AI_SERVICE_URL=http://localhost:8000
