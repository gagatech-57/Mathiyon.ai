# Frontend Environment Variables (Vite)
# Copy this file to .env.local for development

# API Base URL for the deployed backend (local dev defaults to localhost:5000)
# VITE_API_BASE_URL=http://localhost:5000/api
# VITE_API_BASE_URL=https://mathiyon-ai.onrender.com/api

# Express backend
# PORT=5000
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/mathiyon_ai?retryWrites=true&w=majority
# MONGODB_USERNAME=your-mongodb-user
# MONGODB_PASSWORD=your-mongodb-password
# MONGODB_HOST=cluster0.example.mongodb.net
# MONGODB_DB_NAME=mathiyon_ai
# JWT_SECRET=replace-with-strong-secret
# CORS_ORIGINS=http://localhost:8645,http://localhost:5173,https://mathiyon-ai.vercel.app,https://mathiyon-ai.onrender.com
# AI_SERVICE_URL=http://localhost:8000
